<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:id="@+id/w_name"
            android:layout_weight="1"
            android:text="Hermes"
            android:textColor="#F2F1EC"
            android:textSize="17sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_when"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8A8F98"
            android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/w_wait" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#FF8A66" android:textSize="22sp" android:textStyle="bold" android:text="–" />
        <TextView android:id="@+id/w_work" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#D4F75C" android:textSize="22sp" android:textStyle="bold" android:text="–" />
        <TextView android:id="@+id/w_appr" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#F2F1EC" android:textSize="22sp" android:textStyle="bold" android:text="–" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="waiting" android:textColor="#8A8F98" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="working" android:textColor="#8A8F98" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="approvals" android:textColor="#8A8F98" android:textSize="11sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/w_top"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#C9CBD0"
        android:textSize="12.5sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/w_talk" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"
            android:background="@drawable/widget_btn_acc" android:gravity="center" android:text="Talk" android:textColor="#14160F" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_new" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginStart="8dp"
            android:background="@drawable/widget_btn" android:gravity="center" android:text="New" android:textColor="#F2F1EC" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_fleet" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginStart="8dp"
            android:background="@drawable/widget_btn" android:gravity="center" android:text="Fleet" android:textColor="#F2F1EC" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
