<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow cleartext to the emulator host loopback (10.0.2.2) for on-device testing against a local dev server. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application android:networkSecurityConfig="@xml/debug_network">
        <activity android:name=".UiAuditActivity" android:exported="true" />
        <activity android:name=".MarkdownProbeActivity" android:exported="true" />
        <activity android:name=".FleetProbeActivity" android:exported="true" />
        <activity android:name=".BatteryPollingActivity" android:exported="false" />
        <activity android:name=".WakeIsolationProbeActivity" android:exported="true" />
        <activity android:name=".MachineStorageProbeActivity" android:exported="true" />
        <activity android:name=".DownloadIntegrityProbeActivity" android:exported="true" />
        <activity android:name=".RedirectIsolationProbeActivity" android:exported="true" />
    </application>
    <!-- Invoke explicitly on an isolated emulator; excluded from release. -->
    <instrumentation
        android:name=".BatteryPollingProbe"
        android:targetPackage="${applicationId}"
        android:label="Background polling regression probe" />
    <instrumentation
        android:name=".VoiceIngressProbe"
        android:targetPackage="${applicationId}"
        android:label="Voice ingress regression probe" />
</manifest>
