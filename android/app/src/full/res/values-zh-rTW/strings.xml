<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="phone_service_label">Hermes 手機控制</string>
    <string name="phone_service_desc">讓你的 Hermes 代理讀取螢幕內容，並在這支手機上輕觸、輸入和滑動。只有在應用程式中開啟「控制」時才會運作（我、這支手機、控制）。</string>
    <string name="phone_control_notice_title">手機控制已開啟</string>
    <string name="phone_control_notice_text">你的代理可以讀取並操作這支已解鎖的手機。</string>
    <string name="phone_control_stop">停止控制</string>
    <string name="phone_control_accessibility_service">無障礙服務</string>
    <string name="phone_control_service_enabled">已在 Android 設定中啟用。</string>
    <string name="phone_control_service_disabled">請在 Android「無障礙」設定中啟用 %1$s 手機控制。</string>
    <string name="phone_control_allow">允許代理控制</string>
    <string name="phone_control_allow_on">開啟。代理可以讀取、輕觸、輸入、滑動和開啟應用程式。</string>
    <string name="phone_control_allow_off">關閉。不會傳送任何螢幕內容或指令。</string>
    <string name="phone_control_enable_service_first">請先啟用無障礙服務</string>
    <string name="phone_control_server_unavailable">伺服器目前還無法使用手機控制</string>
    <string name="phone_control_enable_channel">請啟用「即時執行與連線」通知類別，確保「停止控制」一直可以使用</string>
    <string name="phone_control_confirm_title">允許手機控制</string>
    <string name="phone_control_activation_cancelled">由於控制、配對或無障礙設定已變更，啟用已取消</string>
    <string name="phone_control_not_armed">伺服器未啟用這支手機的控制，或啟用已被取代</string>
    <string name="phone_control_sideload_help">側載 APK 的首次設定：Android 可能會封鎖無障礙服務。請開啟 Android「設定」→「應用程式」→「%1$s」→ ⋮ →「允許受限制的設定」，然後在這裡啟用服務。這只需要做一次。</string>
    <string name="phone_control_limits">只有在螢幕開啟且已解鎖時才能控制。Android 會封鎖受保護畫面的螢幕截圖。密碼欄位會保持私密。你隨時可以在這裡或從通知關閉控制。</string>
    <string name="phone_control_confirming">請使用指紋或 PIN 確認…</string>
    <string name="channel_tab_control">控制</string>
    <string name="channel_control_section">代理手機控制</string>
    <string name="channel_battery_title">電池最佳化</string>
    <string name="channel_battery_body">有些手機會中斷背景連線。請允許 %1$s 不受限制地執行。</string>
    <string name="channel_allow_unknown_apps">請為 %1$s 允許「安裝不明應用程式」，然後再輕觸檔案一次</string>
    <string name="alarm_exact_off_sub">本機鬧鐘未排定。依賴起床鬧鐘之前，請先允許精確鬧鐘。</string>
    <string name="notify_channel_live">即時執行與連線</string>
    <string name="notify_channel_live_info">執行進度和背景連線</string>
    <string name="notify_connected">已連線</string>
    <string name="phone_settings_push_off">伺服器尚未設定。應用程式會改用自己的連線。</string>
    <string name="phone_settings_push_on">開啟。由 Google 喚醒手機，內容直接來自 %1$s。</string>
    <string name="phone_settings_stay_connected">在背景保持連線</string>
    <string name="phone_settings_stay_connected_sub">保持即時連線並顯示執行進度，會稍微多耗一點電。</string>
</resources>
